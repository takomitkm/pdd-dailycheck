#!/usr/bin/env bash
# 推送前门禁：这次要交给远程的对象里不能有凭据形态。
# pre-commit 挡得住正常提交，但 git commit --no-verify 绕得开；这一道是兜底，
# 扫的是 rev-list 真正会传过去的 blob，跟"分支叫什么、有没有改历史"无关。
#
# 启用（每台开发机一次）：git config core.hooksPath githooks
# 绕过：git push --no-verify（绕了两道，自己负责）
#
# git 从 stdin 每行喂一个被更新的 ref：
#   <本地ref> <本地sha> <远程ref> <远程sha>
# 全 0 的那一头表示"这一侧不存在"：本地全 0 = 删分支，没有新对象可推；远程全 0 = 新建分支，整段历史都要传。
#
# 原则同 pre-commit：扫不动 = 拒绝。git cat-file / rev-list 任何一个环节没成，都按失败处理。
set -uo pipefail

die() { printf '%s\n' "$@" >&2; exit 1; }

hookdir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -r "$hookdir/patterns.sh" ] || die "pre-push: 读不到 $hookdir/patterns.sh，扫描没做成，拒绝推送。"
. "$hookdir/patterns.sh"

ZERO=0000000000000000000000000000000000000000
refs=0
blobs_total=0

while read -r lref lsha rref rsha; do
  [ -n "${lsha:-}" ] || continue
  refs=$((refs + 1))

  # 删分支：本地这头是全 0，推上去的是"没有"，没有新对象。
  [ "$lsha" = "$ZERO" ] && continue
  git cat-file -e "${lsha}^{commit}" 2>/dev/null \
    || die "pre-push: 本地找不到提交 $lsha（$lref），拒绝推送。"

  # 远程那头的提交本地认得出，就只扫 delta；认不出（别人推过 / 本地刚重写过）就整段历史全扫。
  if [ "$rsha" != "$ZERO" ] && git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
    range="${rsha}..${lsha}"
  else
    range="$lsha"
  fi

  objs=$(git rev-list --objects "$range" 2>/dev/null) \
    || die "pre-push: git rev-list --objects $range 失败，扫描没做成，拒绝推送。"

  # rev-list --objects 每行是 "<sha> [路径]"，路径可能带空格，所以只取第一列。
  # 再把类型过一遍，只留 blob——tree/commit 里不会藏端点，但也确实会被传到，扫了不亏。
  blobs=$(printf '%s\n' "$objs" | cut -d' ' -f1 | { git cat-file --batch-check='%(objecttype) %(objectname)' || die "pre-push: cat-file --batch-check 挂了，拒绝推送。"; } | awk '$1=="blob"{print $2}')

  n=$(printf '%s\n' "$blobs" | grep -c . || true)
  blobs_total=$((blobs_total + n))

  for b in $blobs; do
    [ -n "$b" ] || continue
    # 不用 grep -q：pipefail 下 grep 提前退出会让 cat-file 收到 SIGPIPE，命中反而判成没命中。
    hits=$(git cat-file blob "$b" 2>/dev/null | grep -nE -- "$PATTERNS")
    rc=$?
    case $rc in
      0) [ -n "$hits" ] || die "pre-push: blob $b 报命中却给不出行，扫描状态可疑，拒绝推送。"
         # 报路径而不是裸 sha：sha 是 40 位十六进制，会被下面那道隐去长串的 sed 一起糊掉，
         # 只给 sha 等于让人没法定位。rev-list 那行本来就是 "sha 路径"，取回来就行。
         path=$(printf '%s\n' "$objs" | awk -v s="$b" '$1==s{print substr($0, length(s)+2); exit}')
         printf '文件 %s（blob %s…）\n' "${path:-路径未知}" "${b:0:8}" >&2
         printf '%s\n' "$hits" | sed -E 's/[A-Za-z0-9]{25,}/***（已隐去）/g' >&2
         die "
要推的对象里有凭据形态（上面那个 blob），拒绝推送。
拼多多推送端点请写进主机的 ~/Desktop/pdd-push.url，脚本运行时读第一行，不进 git。
真要推（确认是误报）：git push --no-verify。" ;;
      1) : ;;  # 这个 blob 干净
      *) die "pre-push: 扫 blob $b 时 grep 退出码 $rc，扫描没做成，拒绝推送。" ;;
    esac
  done
done

if [ "$refs" = 0 ]; then
  # stdin 一行都没有：git 在推之前没给出任何 ref 更新，没什么可扫，放行。
  exit 0
fi
printf 'pre-push: 扫了 %d 个 ref、%d 个 blob，没有凭据形态。\n' "$refs" "$blobs_total" >&2
exit 0
